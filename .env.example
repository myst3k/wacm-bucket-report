# WACM Connect API credentials (from the Wasabi Account Control Manager console).
# The key is scoped to your control account(s); the report covers everything under it.
WACM_CONNECT_USERNAME=you@example.com
WACM_CONNECT_API_KEY=your-wacm-connect-api-key

# Optional. Leave unset unless a corporate TLS-inspection proxy requires a CA bundle.
# WACM_CA_BUNDLE=/path/to/corp-ca-bundle.pem

# Optional overrides (defaults are correct for Wasabi production).
# WACM_CONNECT_BASE_URL=https://api.wacm.wasabisys.com/api/v1
# WASABI_S3_ENDPOINT=https://s3.{region}.wasabisys.com
